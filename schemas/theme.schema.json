{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDE monitor Theme Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "apiVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apiVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z](?:[a-z0-9.-]*[a-z0-9-])?$",
      "not": {
        "enum": [
          "default",
          "midnight",
          "paper"
        ]
      },
      "allOf": [
        {
          "not": {
            "pattern": "\\.\\."
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "description": "SemVer; Rust installer performs authoritative validation"
    },
    "author": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    }
  }
}
